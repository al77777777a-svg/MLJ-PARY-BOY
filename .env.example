# ── Discord Bot Token ──────────────────────────────────────
# أنشئ بوت من https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# ── Channel ID ─────────────────────────────────────────────
# كلك يمين على القناة > Copy Channel ID
CHANNEL_ID=your_channel_id_here

# ── Location Settings ──────────────────────────────────────
CITY=Dubai
COUNTRY=AE

# ── Calculation Method ─────────────────────────────────────
# 8 = Gulf Region (الأفضل للإمارات)
# 4 = Umm Al-Qura, Makkah
# 3 = Muslim World League
CALCULATION_METHOD=8

# ── GIF URL (Optional) ────────────────────────────────────
# رابط GIF يظهر مع كل تنبيه
GIF_URL=https://media.giphy.com/media/v1.Y2lkPTc5MGI3NjExcm9vZHRiOWRjejV6bHFpMjA3Z2JmaW1nMnRvdHd3ZmFoZHJkZCZlcD12MV9naWZzX3NlYXJjaCZjdD1n/3o7TKz2eMXx7dn95FS/giphy.gif

# ── Mention (من يتم تنبيهه) ────────────────────────────────
# @everyone = الكل
# <@&ROLE_ID> = رول معين
MENTION=@everyone
